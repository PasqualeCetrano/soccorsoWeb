<?xml version="1.0" encoding="UTF-8"?>
<Context path="/soccorsoWeb">
  <!-- Configurazione del Connection Pool per il Database SoccorsoWeb -->
  <!-- jdbc/soccorso è il nome dell'etichetta con cui verrà rappresentata la connessione al DB su cui si baserà Tomcat, che poi verrà presa come riferimento dall'app java -->
  <Resource 
      auth="Container" 
      driverClassName="com.mysql.cj.jdbc.Driver" 
      maxActive="10" 
      maxIdle="5" 
      maxWait="10000" 
      name="jdbc/soccorso" 
      password="098711" 
      type="javax.sql.DataSource" 
      url="jdbc:mysql://localhost:3306/soccorso?connectionTimeZone=LOCAL&amp;forceConnectionTimeZoneToSession=false" 
      username="root" />
</Context>
