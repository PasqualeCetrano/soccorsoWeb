<?xml version="1.0" encoding="UTF-8"?>
<web-app version="4.0" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd">
    
    <!-- Configurazione del database e del framework (Parametri globali) -->
    <!--variabile globale per definire la codifica dei caratteri sul web da utilizzare-->
    <context-param>
        <param-name>view.encoding</param-name>
        <param-value>UTF-8</param-value>
    </context-param>
    <!--Tutti i file HTML (i template di FreeMarker) di questo progetto sono salvati dentro la cartella chiamata templates-->
    <context-param>
        <param-name>view.template_directory</param-name>
        <param-value>templates</param-value>
    </context-param>
    <!--variabile globale per definire la pagina HTML da mostrare quando si verifica un errore-->
    <context-param>
        <param-name>view.error_template</param-name>
        <param-value>error.html</param-value>
    </context-param>
    <!-- Se impostato a true, mostra gli errori dettagliati di FreeMarker a schermo e disabilita la cache. 
    Da mettere a false quando il sito va online, in maniera tale che se lo sviluppatore
    modifica delle cose creando degli errori, non compare l'errore ma direttamente 
    una pagina di errore! -->
    <context-param>
        <param-name>view.debug</param-name>
        <param-value>true</param-value>
    </context-param>
    <!-- ogni volta che la Servlet gli passa un oggetto di tipo Data, lo stampa nella pagina HTML seguendo questo formato-->
    <context-param>
        <param-name>view.date_format</param-name>
        <param-value>dd/MM/yyyy hh:mm:ss</param-value>
    </context-param>
    <!-- Le pagine il cui URL corrisponde a /admin/.* sono accessibili da chi ha ruolo amministratore;
    le pagine il cui URL corrisponde a /operatore/.* sono accessibili da chi ha ruolo operatore o amministratore -->
    <context-param>
        <param-name>security.protect.patterns</param-name>
        <param-value>
            /admin/.*=amministratore;
            /operatore/.*=operatore,amministratore
        </param-value>
    </context-param>
    
    <context-param>
        <param-name>data.source</param-name>
        <!-- qui configuriamo il nome della data source da usare nel codice per comunicare con il DB -->
        <param-value>jdbc/soccorso</param-value>
    </context-param>

    <!-- definisce chi è la classe (ApplicationInitializer) che si occupa di inizializzare 
    l'applicazione all'avvio del server. In particolare, questa classe si occupa di 
    inizializzare la connessione al DB e di definire le regole di protezione delle pagine 
    (Ascoltatore)-->
    <listener>
        <listener-class>it.univaq.framework.application.ApplicationInitializer</listener-class>
    </listener>

    <!-- ============================================== -->
    <!-- MAPPATURE DELLE SERVLET DELLA PARTE PUBBLICA   -->
    <!-- ============================================== -->

    <!-- 1. HomepageController -->
    <servlet>
        <servlet-name>HomepageServlet</servlet-name>
        <servlet-class>it.univaq.soccorsoweb.controller.pubblico.HomepageController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomepageServlet</servlet-name>
        <url-pattern>/homepage</url-pattern>
    </servlet-mapping>
    <!-- è un modo alternativo in cui l'utente può digitare nel campo search bar del browser per accedere alla homepage -->
    <servlet-mapping>
        <servlet-name>HomepageServlet</servlet-name>
        <url-pattern>/index.html</url-pattern>
    </servlet-mapping>
    <!-- è un altro modo alternativo in cui l'utente può digitare nel campo search bar del browser per accedere alla homepage -->
    <servlet-mapping>
        <servlet-name>HomepageServlet</servlet-name>
        <url-pattern>/Home</url-pattern>
    </servlet-mapping>

    <!-- 2. InviaRichiestaController -->
    <servlet>
        <servlet-name>InviaRichiestaServlet</servlet-name>
        <servlet-class>it.univaq.soccorsoweb.controller.pubblico.InviaRichiestaController</servlet-class>
        <!-- Impostazione vitale per permettere il caricamento delle foto (multipart) -->
        <multipart-config>
            <max-file-size>10485760</max-file-size> <!-- 10MB -->
            <max-request-size>20971520</max-request-size> <!-- 20MB -->
            <file-size-threshold>5242880</file-size-threshold> <!-- 5MB -->
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>InviaRichiestaServlet</servlet-name>
        <url-pattern>/InviaRichiestaServlet</url-pattern>
    </servlet-mapping>

    <!-- 3. ConvalidaRichiestaController -->
    <servlet>
        <servlet-name>ConvalidaRichiestaServlet</servlet-name>
        <servlet-class>it.univaq.soccorsoweb.controller.admin.ConvalidaRichiestaController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ConvalidaRichiestaServlet</servlet-name>
        <url-pattern>/ConvalidaRichiestaServlet</url-pattern>
    </servlet-mapping>
    
    <!-- 4. HomeAdminController (Hub Centrale) -->
    <servlet>
        <servlet-name>HomeAdminServlet</servlet-name>
        <servlet-class>it.univaq.soccorsoweb.controller.admin.HomeAdminController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeAdminServlet</servlet-name>
        <url-pattern>/admin/home</url-pattern>
    </servlet-mapping>

    <!-- 5. GestioneRichiesteController (Tabella Emergenze) -->
    <servlet>
        <servlet-name>GestioneRichiesteServlet</servlet-name>
        <servlet-class>it.univaq.soccorsoweb.controller.admin.GestioneRichiesteController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GestioneRichiesteServlet</servlet-name>
        <url-pattern>/admin/richieste</url-pattern>
    </servlet-mapping>
    
    <!-- 6. HomeOperatoreController (Pannello Operatore) -->
    <servlet>
        <servlet-name>HomeOperatoreServlet</servlet-name>
        <servlet-class>it.univaq.soccorsoweb.controller.operatore.HomeOperatoreController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeOperatoreServlet</servlet-name>
        <url-pattern>/operatore/dashboard</url-pattern>
    </servlet-mapping>

    <!-- 7. MissioniOperatoreController (Le Mie Missioni) -->
    <servlet>
        <servlet-name>MissioniOperatoreServlet</servlet-name>
        <servlet-class>it.univaq.soccorsoweb.controller.operatore.MissioniOperatoreController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MissioniOperatoreServlet</servlet-name>
        <url-pattern>/operatore/missioni</url-pattern>
    </servlet-mapping>

    <!-- 8. AggiungiCompetenzeController (Gestione Competenze) -->
    <servlet>
        <servlet-name>AggiungiCompetenzeServlet</servlet-name>
        <servlet-class>it.univaq.soccorsoweb.controller.operatore.AggiungiCompetenzeController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AggiungiCompetenzeServlet</servlet-name>
        <url-pattern>/operatore/competenze</url-pattern>
    </servlet-mapping>

    <!-- Registra la classe Java 'LoginController' nel server assegnandole il soprannome 'LoginServlet' 
    (che verrà poi collegato a un URL specifico più in basso, nella sezione servlet-mapping) -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>it.univaq.soccorsoweb.controller.pubblico.LoginController</servlet-class>
    </servlet>
    <!-- Questo blocco è il "ponte" tra l'utente e il codice Java.
    Dice al server: "Quando un utente digita '/login' nella barra degli indirizzi 
    del browser (url-pattern), avvia immediatamente la classe Java che 
    abbiamo registrato con il soprannome 'LoginServlet' (servlet-name)" -->
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- LogoutController -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>it.univaq.soccorsoweb.controller.pubblico.LogoutController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/Logout</url-pattern>
    </servlet-mapping>

    <!-- Definisce la durata massima della sessione in minuti. 
    Se un utente (anche loggato) non compie alcuna azione sul sito per questo 
    intervallo di tempo (es. 30 minuti), la sua sessione scade e verrà 
    disconnesso automaticamente dal sistema per questioni di sicurezza. -->
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>

    <!--Se un utente digita solo l'indirizzo principale del sito senza specificare 
    nessuna pagina, tu fingi che abbia digitato la parola homepage-->
    <welcome-file-list>
        <welcome-file>homepage</welcome-file>
    </welcome-file-list>
    <!-- Dichiara che questa applicazione ha bisogno di connettersi a un Database.
    Nota: le credenziali vere (username e password) non si scrivono qui per sicurezza, 
    ma andranno inserite nel file separato "context.xml" gestito dal server. -->
    <resource-ref>
        <!-- Il nome identificativo della connessione. Il codice Java (es. l'ApplicationInitializer) 
        cercherà esattamente questo nome per collegarsi al DB. -->
        <res-ref-name>jdbc/soccorso</res-ref-name>
        
        <!-- Specifica la tipologia di risorsa: in questo caso un Database relazionale (SQL). -->
        <res-type>javax.sql.DataSource</res-type>
        
        <!-- Delega l'autenticazione (accesso con password) direttamente al "Contenitore",
        ovvero al server Tomcat. -->
        <res-auth>Container</res-auth>
        
        <!-- Permette di condividere la connessione tra più richieste degli utenti 
        in contemporanea, ottimizzando la velocità del sito. -->
        <res-sharing-scope>Shareable</res-sharing-scope>
    </resource-ref>

</web-app>
