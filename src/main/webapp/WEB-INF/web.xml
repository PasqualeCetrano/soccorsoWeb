    <!-- Definisce la durata massima della sessione in minuti,implementato di default su tomcat -->
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>

    <!--usato se un utente digita solo l'indirizzo principale del sito senza specificare 
    nessuna pagina, implementato di default su tomcat-->
    <welcome-file-list>
        <welcome-file>homepage</welcome-file>
    </welcome-file-list>
    <!-- Dichiara che questa applicazione ha bisogno di connettersi a un Database.-->
    <resource-ref>
        <!-- Nome con cui l'applicazione cerca nel contesto il database configurato in context.xml  -->
        <res-ref-name>jdbc/soccorso</res-ref-name>
        <!-- Specifica che il Database SQL. -->
        <res-type>javax.sql.DataSource</res-type>
        <!-- l'autenticazione viene fatta da tomcat. -->
        <res-auth>Container</res-auth>
        
        <!-- Permette di condividere la connessione tra più richieste degli utenti 
        in contemporanea. -->
        <res-sharing-scope>Shareable</res-sharing-scope>
    </resource-ref>

